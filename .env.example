# Ports
HTTP_PORT=3000
HTTPS_PORT=3001
# Container listener ports
# SELKIES_PORT=3000
# SELKIES_HTTPS_PORT=3001

# WeChat host name; leave empty to use Docker's automatically generated host name
WECHAT_HOSTNAME=

# Keep the previous container's IDs when upgrading. Defaults are 1000:100
# with the supplied Compose file and 911:911 when running the image directly.
# PUID=1000
# PGID=100

# Selkies Web UI
# CUSTOM_USER=abc
# TITLE=WeChat-Selkies
# SUBFOLDER=/
# SELKIES_PELORUS=true
# Set a nonempty password for web access.
PASSWORD=

# Desktop session
# TZ=Asia/Shanghai
# LC_ALL=zh_CN.UTF-8
# AUTO_START_WECHAT=true
# AUTO_START_QQ=false

# Local build options
# INSTALL_QQ=true
# INSTALL_PCMANFM=true

# Shared Memory
SHM_SIZE=1gb

# Nightly WeChat Restart Schedule
# ENABLE_WECHAT_NIGHTLY_RESTART=true
# WECHAT_NIGHTLY_STOP_TIME=23:30
# WECHAT_NIGHTLY_START_TIME=01:30

# WeChat Auto-Login on Startup/Restart
# ENABLE_WECHAT_AUTO_LOGIN=false
# AUTO_LOGIN_DELAY=3
